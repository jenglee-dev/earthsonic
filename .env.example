# EarthSonic Environment Configuration Example
# Copy to .env as needed. Never commit real credentials or secrets.

# Server Configuration (/server)
PORT=3001
HOST=127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
CACHE_TTL_MS=900000
UPSTREAM_TIMEOUT_MS=8000
# Optional server-side NASA Earthdata Bearer Token (not required; GISTEMP, POWER & GIBS require no key)
NASA_EARTHDATA_TOKEN=

# Web Frontend Configuration (/web)
VITE_API_BASE_URL=http://127.0.0.1:3001/api/v1
VITE_BASE_PATH=/
