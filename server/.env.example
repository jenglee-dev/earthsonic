# EarthSonic Backend (/server) Environment Variables
# Copy to server/.env or configure in Render Dashboard. Never commit real secrets.

# Port assigned by Render in production; defaults to 3001 locally
PORT=3001
# Host defaults to 127.0.0.1 locally and 0.0.0.0 in production
HOST=127.0.0.1
# Comma-separated list of allowed frontend origins (e.g. https://your-app.vercel.app)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# In-memory upstream cache TTL in milliseconds (default: 15 minutes)
CACHE_TTL_MS=900000
# Upstream NASA API request timeout in milliseconds (default: 8 seconds)
UPSTREAM_TIMEOUT_MS=8000
# Optional NASA Earthdata Bearer Token (not required; GISTEMP, POWER & GIBS require no key)
NASA_EARTHDATA_TOKEN=
