{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build --workspace=shared && npm run build --workspace=web",
  "outputDirectory": "web/dist",
  "rewrites": [
    {
      "source": "/((?!assets/|textures/|sw\\.js|workbox-.*\\.js|manifest\\.webmanifest|registerSW\\.js|favicon\\.svg|icons\\.svg|logo\\.svg|offline\\.html|.*\\..*).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ]
}
